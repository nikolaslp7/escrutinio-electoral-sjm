# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO DE EJEMPLO (.env.example)
# Proyecto: Escrutinio Electoral SJM - PWA Oficial
# ------------------------------------------------------------------------------
# INSTRUCCIONES:
# Copia este archivo a `.env.local` si requieres personalizar variables locales:
#   cp .env.example .env.local
#
# NOTA DE SEGURIDAD (DEVSECOPS):
# - NUNCA guardes llaves privadas, contraseñas de producción ni tokens reales aquí.
# - Esta aplicación funciona local-first en el cliente con Zustand y LocalStorage,
#   por lo que no requiere credenciales de bases de datos para su operación básica.
# ==============================================================================

# Entorno de ejecución de Node
NODE_ENV=development

# Puerto del servidor de desarrollo local (opcional)
PORT=3000

# URL pública de la aplicación (usado en metadatos y OpenGraph si aplica)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nombre público de la aplicación
NEXT_PUBLIC_APP_NAME="Escrutinio Electoral SJM - APP"

# Versión del aplicativo
NEXT_PUBLIC_APP_VERSION=0.1.0
