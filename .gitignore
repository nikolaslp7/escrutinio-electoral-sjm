# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD Y EXCLUSIONES DE GIT (.gitignore)
# Proyecto: Escrutinio Electoral SJM
# DevSecOps Hardening & Sanitization
# ==============================================================================

# Dependencias y builds
node_modules/
.next/
out/
build/
dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Variables de entorno y secretos
.env
.env*.local
.env.production
.env.development
.env.test
.env.local
# Permitir únicamente la plantilla de ejemplo sanitizada
!.env.example

# Logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Archivos temporales de IDEs y sistemas operativos
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Artefactos y reportes temporales generados
*.pdf
*.log

# Certificados y llaves criptográficas
*.pem
*.key
*.cert

# Testing y Cobertura
coverage/

# Vercel & TypeScript
.vercel
*.tsbuildinfo
next-env.d.ts
